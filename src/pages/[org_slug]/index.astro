---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OrgTabShell from '../../components/OrgTabShell';
import { supabase } from '../../lib/supabase';

const { org_slug } = Astro.params;

const { data: org } = await supabase
  .from('organizations')
  .select('id, name, slug, logo_url, welcome_text, lat, lng')
  .eq('slug', org_slug)
  .single();

if (!org) {
  return new Response(null, { status: 404 });
}

const today = new Date().toISOString().split('T')[0];

const { data: partners } = await supabase
  .from('partners')
  .select(`
    id, org_id, slug, name, description, logo_url, credit_balance, bonus_info, bonus_reusable,
    lat, lng, phone, hours, cover_photo_url, photos,
    daily_menus!inner(menu_text)
  `)
  .eq('org_id', org.id)
  .eq('daily_menus.date', today);

const { data: faqs } = await supabase
  .from('faqs')
  .select('id, org_id, question, answer, category, created_at')
  .eq('org_id', org.id)
  .order('category');

const menus = (partners ?? []).map((p) => ({
  partnerName: p.name,
  menuText: p.daily_menus[0]?.menu_text ?? '',
}));
---

<BaseLayout title={`LocalMate — ${org.name}`}>
  <OrgTabShell
    org={org}
    partners={partners ?? []}
    menus={menus}
    faqs={faqs ?? []}
    client:load
  />

</BaseLayout>
